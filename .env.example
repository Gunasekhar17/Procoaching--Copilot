# Set this in the Vercel dashboard (Project → Settings → Environment Variables),
# NOT in this file — .env is not deployed. This is just documentation of what's needed.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o
